{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roll-down-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "kv_namespaces": [
    { "binding": "LEADERBOARD", "id": "55fffa2ffbe546edac2b6044d27a9188" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
