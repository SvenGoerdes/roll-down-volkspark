{
  "$schema": "https://opencode.ai/config.json",
  // Project rules for OpenCode panes (ADR 0026). Last matching rule wins.
  "permission": {
    // Sub-agents guess or mistype paths outside their worktree. Deny them so they correct themselves
    // instead of waiting for the user. Only temp files and OpenCode's own data stay reachable.
    "external_directory": {
      "*": "deny",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders/*": "allow",
      "/Users/svengoerdes/.local/share/opencode/*": "allow"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "GIT_EDITOR=true git *": "allow",
      "gh *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "python3 *": "allow",
      "blender *": "allow",
      "/Applications/Blender.app/Contents/MacOS/Blender *": "allow",
      "cwebp *": "allow",
      "magick *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "open *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "sips *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "test *": "allow",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "gh pr merge*": "deny",
      "gh repo *": "ask",
      // gh api may read; anything that sends a method or a body asks.
      "gh api *": "allow",
      "gh api *-X*": "ask",
      "gh api *--method*": "ask",
      "gh api *-f *": "ask",
      "gh api *-F *": "ask",
      "gh api *--field*": "ask",
      "gh api *--raw-field*": "ask",
      "gh api *--input*": "ask"
    }
  },
  "agent": {
    "coder": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "description": "Writes code for a small, clearly specified task. Give it the files, the goal and the tests to run."
    },
    "reviewer": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "reasoningEffort": "medium",
      "description": "Reviews a diff for bugs, KISS, performance on phones and missing tests. Reports findings only, never edits.",
      "permission": { "edit": "deny" }
    }
  }
}
